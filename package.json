{
  "name": "cheaplive",
  "version": "1.0.0",
  "type": "module",
  "description": "> 一个面向移动端个人主播的零成本虚拟主播直播辅助工具。 > 无需电脑，纯浏览器端运行，让任何有手机的普通人都能成为虚拟主播。",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npx playwright test",
    "test:unit": "node tests/run-unit-tests.mjs",
    "test:signaling": "node --test tests/unit/signaling-server.test.js",
    "test:assets": "npm run assets:check && node --test tests/unit/web-asset-sync.test.mjs",
    "test:e2e": "npx playwright test tests/e2e --project=chromium-desktop",
    "test:status": "npx playwright test tests/public-status --project=chromium-desktop",
    "test:smoke": "npx playwright test tests/e2e/smoke.test.cjs tests/e2e/playwright-smoke.test.cjs --project=chromium-desktop",
    "test:visual": "node tests/e2e/generate-screenshots.js",
    "test:webrtc": "npx playwright test tests/e2e/webrtc-connected.test.cjs tests/e2e/audio-track.test.cjs tests/e2e/multi-device.test.cjs --project=chromium-desktop",
    "test:experimental": "npm run test:webrtc",
    "test:gate": "node --test tests/unit/*.test.js && npx playwright test tests/e2e/playwright-smoke.test.cjs tests/public-status --project=chromium-desktop --reporter=list",
    "test:gate-verify": "node tests/unit/gate-exit-code.test.js",
    "test:all": "npm run test:unit && npm run test:assets && npm run test:signaling && npm run test:e2e",
    "assets:check": "node scripts/sync-contest-demo-to-android.mjs --check",
    "assets:sync": "node scripts/sync-contest-demo-to-android.mjs --write",
    "license:audit": "node scripts/audit-third-party-licenses.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamZebrado/CheapLive.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SamZebrado/CheapLive/issues"
  },
  "homepage": "https://github.com/SamZebrado/CheapLive#readme",
  "dependencies": {
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "http-server": "^14.1.1",
    "playwright": "^1.61.0"
  }
}
